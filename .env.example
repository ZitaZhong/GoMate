# 「周末去哪儿」环境变量示例（复制为 .env 使用）
# 数据库指向 Docker 隔离实例（端口 5433），绝不指向本地现有 PostgreSQL。
# 任一项 key 留空 → 自动走确定性兜底（不阻断，离线可跑）。

# —— 启用真实模型（embedding/rerank 走 API；LLM 只要填了 key 就生效）——
WTG_USE_REAL_MODELS=true

# ===================== LLM（OpenAI 兼容 /chat/completions）=====================
# 任何 OpenAI 兼容端点均可：OpenAI 官方 / DeepSeek / 智谱 / 通义百炼兼容模式 / OneAPI 代理等。
WTG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WTG_LLM_API_KEY=
WTG_LLM_MODEL_DEFAULT=qwen3.7-plus
# 通用 OpenAI 端点用单模型即可（false）；仅当用通义千问并想分层省钱时才置 true（走 LLM_ROUTES）。
WTG_LLM_USE_ROUTES=false

# ===================== Embedding（OpenAI 兼容 /embeddings）=====================
# 若 embedding 与 LLM 是同一服务商，下面 BASE_URL/API_KEY 留空即可（自动复用上面的 LLM 配置）。
# 若是不同服务商（如单独的向量模型代理），填这里覆盖。
# 模型名必须与所用端点匹配：OpenAI 端点用 text-embedding-3-small；
# DashScope 兼容端点用 text-embedding-v3。
WTG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
WTG_EMBEDDING_API_KEY=
WTG_EMBEDDING_API_MODEL=Qwen/Qwen3-Embedding-8B
# 自建/离线索引用的本地模型与版本（与上面 API 模型互不影响；确定性兜底时用到）。
WTG_EMBEDDING_MODEL=BAAI/bge-m3
WTG_EMBEDDING_VERSION=bge-m3-v1
# 维度必须与库列 VECTOR(1024) 一致：text-embedding-3-* 用 dimensions=1024 截断；
# 若你的模型本身即 1024 维（如 BGE-M3 兼容端点）且会因 dimensions 参数报错，把下面置 false。
WTG_EMBEDDING_DIM=1024
WTG_EMBEDDING_PASS_DIMENSIONS=true

# —— Rerank（可选；OpenAI 无 rerank API，留空→确定性 Lexical 重排兜底）——
# 仅当用 DashScope gte-rerank 时才填 WTG_DASHSCOPE_API_KEY；否则保持空。
WTG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
WTG_RERANK_API_MODEL=gte-rerank
WTG_DASHSCOPE_API_KEY=

# ===================== 搜索（bocha|tavily|exa|serper）=====================
WTG_SEARCH_PROVIDER=tavily
WTG_SEARCH_API_KEY=

# ===================== 深度研究（DD-17，走上面搜索+LLM）=====================
WTG_DEEP_RESEARCH_ENABLED=true
WTG_DEEP_RESEARCH_MAX_ROUNDS=3
WTG_DEEP_RESEARCH_TIME_BUDGET_S=300
WTG_DEEP_RESEARCH_MAX_SUBAGENTS=4
WTG_DEEP_RESEARCH_CONCURRENCY=8
WTG_DEEP_RESEARCH_CACHE_TTL_S=300
WTG_DEEP_RESEARCH_MIN_COVERAGE=0.8

# ===================== 其它 Provider（DD-04；可选；留空→兜底）=====================
WTG_AMAP_KEY=
WTG_QWEATHER_KEY=
WTG_VARIFLIGHT_KEY=

# —— 提醒 / ICS / 对象存储（DD-13；无 key→stub/本地兜底）——
WTG_VAPID_PUBLIC_KEY=
WTG_VAPID_PRIVATE_KEY=
WTG_RESEND_API_KEY=
WTG_ICS_TOKEN_SECRET=wheretogo-ics-dev-secret
WTG_OSS_ENDPOINT=
WTG_OSS_BUCKET=
WTG_OSS_ACCESS_KEY=
WTG_OSS_SECRET_KEY=

# ===================== 数据库 / Redis（隔离实例，勿改）=====================
WTG_DB_HOST=127.0.0.1
WTG_DB_PORT=5433
WTG_DB_USER=wheretogo
WTG_DB_PASSWORD=wheretogo_dev_pwd
WTG_DB_NAME=wheretogo
# LangGraph checkpoint 独立 schema（DD-01 §9.3）
WTG_DB_LANGGRAPH_SCHEMA=langgraph
WTG_REDIS_HOST=127.0.0.1
WTG_REDIS_PORT=6380
WTG_REDIS_DB=0

# —— 应用 ——
WTG_APP_ENV=dev
WTG_LOG_LEVEL=INFO
